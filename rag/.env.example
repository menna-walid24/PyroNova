# Copy to rag/.env and fill in. rag/.env is git-ignored — never commit it.
OPENROUTER_API_KEY=
# Optional overrides
# Free models (work without OpenRouter credits; check https://openrouter.ai/models?max_price=0).
# With credits you can switch back to qwen/qwen-2.5-72b-instruct + qwen/qwen3-30b-a3b.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODEL=baidu/ernie-5.5-flash-preview:free
